# Copy to .env (never commit .env). For production, upload your real .env
# to Jenkins as a "Secret file" credential with ID: mern-env-file
DOCKERHUB_USERNAME=your-dockerhub-username
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
# Must use the same user and password as above; host name is the service name "mongo"
MONGO_URI=mongodb://admin:change-me@mongo:27017/tasks?authSource=admin
PORT=5000
NODE_ENV=production
# Port on the host where the app is published
APP_PORT=3000
